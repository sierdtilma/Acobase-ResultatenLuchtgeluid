{
  "name": "resultatenluchtgeluid",
  "description": "Power BI custom visual voor Acobase resultaten luchtgeluid",
  "version": "1.0.1.189",
  "repository": {
    "type": "git",
    "url": "https://github.com/sierdtilma/Acobase-ResultatenLuchtgeluid.git"
  },
  "license": "MIT",
  "scripts": {
    "pbiviz": "node scripts/pbiviz-wrapper.js",
    "pbiviz:raw": "node ./node_modules/powerbi-visuals-tools/bin/pbiviz.js",
    "bump-version": "node scripts/bump-version.js",
    "sync-version": "node scripts/sync-version.js",
    "publish-github": "node scripts/publish-github.js",
    "start": "npm run pbiviz -- start",
    "package": "npm run pbiviz -- package",
    "lint": "eslint . --max-warnings=0",
    "eslint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --test scripts/visual-validation.test.js",
    "certify": "node scripts/certify-check.js"
  },
  "dependencies": {
    "powerbi-models": "^2.1.1",
    "powerbi-visuals-api": "5.11.1",
    "powerbi-visuals-utils-formattingmodel": "6.0.4",
    "powerbi-visuals-utils-formattingutils": "^6.1.0"
  },
  "overrides": {
    "braces": "https://codeload.github.com/sierdtilma/braces/tar.gz/ce0ea90413e22d184f73b840f34770fd47b163ef",
    "sockjs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "eslint": "^9.11.1",
    "eslint-plugin-powerbi-visuals": "^1.0.0",
    "powerbi-visuals-tools": "^7.2.1",
    "typescript": "5.5.4"
  }
}
